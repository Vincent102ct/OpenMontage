      "start_seconds": 41.859,
      "end_seconds": 44.191,
      "narration": {
        "char_start": 91,
        "char_end": 125,
        "text": "chưa có câu trả lời được xác lập. ",
        "subtitle_cue_numbers": [
          12
        ],
        "start_seconds": 41.859,
        "end_seconds": 44.191,
        "timing_basis": "measured_segment_character_distributed_cues_not_word_alignment"
