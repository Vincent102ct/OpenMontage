      "end_seconds": 3.873,
      "narration": {
        "char_start": 0,
        "char_end": 46,
        "text": "Brazil, năm một nghìn chín trăm sáu mươi sáu. ",
        "subtitle_cue_numbers": [
          1
        ],
        "start_seconds": 0.3,
        "end_seconds": 3.873,
        "timing_basis": "measured_segment_character_distributed_cues_not_word_alignment"
      }
    },
    {
      "id": "SC_002",
      "segment_id": "SEG_01",
      "start_seconds": 3.873,
      "end_seconds": 9.986,
      "narration": {
        "char_start": 46,
        "char_end": 124,
        "text": "Hai người làm nghề điện tử được tìm thấy đã chết trên một ngọn đồi ở Niterói. ",
        "subtitle_cue_numbers": [
          2
        ],
        "start_seconds": 3.873,
        "end_seconds": 9.986,
        "timing_basis": "measured_segment_character_distributed_cues_not_word_alignment"
      }
    },
    {
      "id": "SC_003",
      "segment_id": "SEG_01",
      "start_seconds": 9.986,
      "end_seconds": 12.927,
      "narration": {
        "char_start": 124,
        "char_end": 157,
        "text": "Họ mặc vest. Bên ngoài là áo mưa.",
        "subtitle_cue_numbers": [
          3,
          4
        ],
        "start_seconds": 9.986,
        "end_seconds": 12.527,
        "timing_basis": "measured_segment_character_distributed_cues_not_word_alignment"
      }
    },
    {
      "id": "SC_004",
      "segment_id": "SEG_02",
      "start_seconds": 12.927,
      "end_seconds": 17.591,
      "narration": {
        "char_start": 0,
        "char_end": 59,
        "text": "Ở hiện trường còn có hai tấm chì, tạo hình như nửa mặt nạ. ",
        "subtitle_cue_numbers": [
          5
        ],
        "start_seconds": 12.927,
        "end_seconds": 17.591,
        "timing_basis": "measured_segment_character_distributed_cues_not_word_alignment"
      }
    },
    {
      "id": "SC_005",
      "segment_id": "SEG_02",
      "start_seconds": 17.591,
      "end_seconds": 23.297625,
      "narration": {
        "char_start": 59,
        "char_end": 125,
        "text": "Và một mẩu giấy ghi những việc phải làm, vào những giờ rất cụ thể.",
        "subtitle_cue_numbers": [
          6
        ],
        "start_seconds": 17.591,
        "end_seconds": 22.897625,
        "timing_basis": "measured_segment_character_distributed_cues_not_word_alignment"
      }
    },
    {
      "id": "SC_006",
      "segment_id": "SEG_19",
      "start_seconds": 23.297625,
      "end_seconds": 25.986,
      "narration": {
        "char_start": 0,
        "char_end": 38,
        "text": "Mười tám giờ ba mươi: uống viên nang. ",
        "subtitle_cue_numbers": [
          7,
          8
        ],
        "start_seconds": 23.297625,
        "end_seconds": 25.986,
        "timing_basis": "measured_segment_character_distributed_cues_not_word_alignment"
      }
    },
    {
      "id": "SC_007",
      "segment_id": "SEG_19",
      "start_seconds": 25.986,
      "end_seconds": 31.439,
      "narration": {
        "char_start": 38,
        "char_end": 112,
        "text": "Đó là điều được viết, không phải xác nhận rằng hai người thực sự đã uống. ",
        "subtitle_cue_numbers": [
          9
        ],
        "start_seconds": 25.986,
        "end_seconds": 31.439,
        "timing_basis": "measured_segment_character_distributed_cues_not_word_alignment"
      }
    },
    {
      "id": "SC_008",
      "segment_id": "SEG_19",
      "start_seconds": 31.439,
      "end_seconds": 35.498417,
      "narration": {
        "char_start": 112,
        "char_end": 161,
        "text": "Càng không phải tên của chất nằm trong viên nang.",
        "subtitle_cue_numbers": [
          10
        ],
        "start_seconds": 31.439,
        "end_seconds": 35.098417,
        "timing_basis": "measured_segment_character_distributed_cues_not_word_alignment"
      }
    },
    {
      "id": "SC_009",
      "segment_id": "SEG_45",
      "start_seconds": 35.498417,
      "end_seconds": 41.859,
      "narration": {
        "char_start": 0,
        "char_end": 91,
        "text": "Còn viên nang chứa gì, họ thực sự làm gì trên đồi, có ai khác ở đó, và vì sao cả hai chết: ",
        "subtitle_cue_numbers": [
          11
        ],
        "start_seconds": 35.498417,
        "end_seconds": 41.859,
        "timing_basis": "measured_segment_character_distributed_cues_not_word_alignment"
      }
    },
    {
