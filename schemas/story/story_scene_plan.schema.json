{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/story/story_scene_plan.schema.json",
  "title": "Story Scene Plan (P3.4 Short and Long scene/shot plans)",
  "description": "Immutable scene-planning candidate compiled from a verified, explicitly approved Reviewed Fiction Story Package and an approved Story Visual Bible. Source fields are read-only canon; staging is a creative proposal; timing is a provisional estimate pending measured narration. The file cannot approve itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "project_id", "version", "style", "inputs", "language", "title",
               "source_facts_policy", "staging_policy", "formats", "shared_identity", "retiming_contract", "coverage",
               "continuity", "review", "warnings", "blockers", "review_status", "approval_scope", "tts_started",
               "rendering_started", "production_started", "publishing_enabled"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact": {"const": "story_scene_plan"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "style": {"const": "cinematic_2d_cartoon_supernatural_horror"},
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewed_story", "visual_bible", "library", "assets", "acting_presets"],
      "properties": {
        "reviewed_story": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "version", "source_sha256", "working_text_sha256", "package_sha256", "manifest_sha256",
                       "approval_sha256", "decision_history_sha256"],
          "properties": {
            "kind": {"const": "reviewed_fiction"},
            "version": {"type": "string", "pattern": "^v[2-9][0-9]*$|^v[1-9][0-9]+$"},
            "source_sha256": {"$ref": "#/$defs/sha256"}, "working_text_sha256": {"$ref": "#/$defs/sha256"},
            "package_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "approval_sha256": {"$ref": "#/$defs/sha256"}, "decision_history_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "visual_bible": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "package_sha256", "manifest_sha256", "approval_sha256", "handoff_sha256"],
          "properties": {
            "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
            "package_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "approval_sha256": {"$ref": "#/$defs/sha256"}, "handoff_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "library": {
          "type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"],
          "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
        },
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset_pin"}},
        "acting_presets": {"type": "array", "items": {"$ref": "#/$defs/asset_pin"}}
      }
    },
    "language": {"type": "string", "pattern": "^[a-z]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "source_facts_policy": {"type": "string"},
    "staging_policy": {"type": "string"},
    "formats": {
      "type": "object", "additionalProperties": false, "required": ["short", "long"],
      "properties": {"short": {"$ref": "#/$defs/format_plan"}, "long": {"$ref": "#/$defs/format_plan"}}
    },
    "shared_identity": {
      "type": "object", "additionalProperties": false, "required": ["characters", "locations"],
      "properties": {
        "characters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "locations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
      }
    },
    "retiming_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "contract_version", "status", "fps", "lead_seconds", "tail_seconds", "minimum_shot_seconds",
                   "narration_units", "measurement_fields", "rules"],
      "properties": {
        "artifact": {"const": "scene_plan_retiming_contract"},
        "contract_version": {"const": "1.0"},
        "status": {"const": "awaiting_p3_5_measured_narration"},
        "fps": {"const": 30}, "lead_seconds": {"type": "number"}, "tail_seconds": {"type": "number"},
        "minimum_shot_seconds": {"type": "number"},
        "narration_units": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["unit_id", "format", "shot_id", "text_sha256", "estimated_seconds"],
            "properties": {
              "unit_id": {"$ref": "#/$defs/beat_id"}, "format": {"enum": ["short", "long"]},
              "shot_id": {"$ref": "#/$defs/shot_id"}, "text_sha256": {"$ref": "#/$defs/sha256"},
              "estimated_seconds": {"type": "number", "minimum": 0}
            }
          }
        },
        "measurement_fields": {"type": "array", "items": {"type": "string"}},
        "rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["formats", "blockers", "basis"],
      "properties": {"formats": {"type": "object"}, "blockers": {"$ref": "#/$defs/strings"}, "basis": {"type": "string"}}
    },
    "continuity": {
      "type": "object", "additionalProperties": false,
      "required": ["formats", "shared_events_checked", "format_mismatches", "identity", "canonical_rules",
                   "canonical_ambiguities", "blockers"],
      "properties": {
        "formats": {"type": "object"}, "shared_events_checked": {"$ref": "#/$defs/strings"},
        "format_mismatches": {"type": "array"}, "identity": {"type": "object"}, "canonical_rules": {"type": "array"},
        "canonical_ambiguities": {"type": "array"}, "blockers": {"$ref": "#/$defs/strings"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["coverage_reviewed", "continuity_reviewed"],
      "properties": {"coverage_reviewed": {"type": "boolean"}, "continuity_reviewed": {"type": "boolean"}}
    },
    "warnings": {"$ref": "#/$defs/strings"},
    "blockers": {"$ref": "#/$defs/strings"},
    "review_status": {"const": "pending_explicit_scene_plan_approval"},
    "approval_scope": {"const": "scene_plan_only"},
    "tts_started": {"const": false},
    "rendering_started": {"const": false},
    "production_started": {"const": false},
    "publishing_enabled": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "version", "package_sha256", "manifest_sha256", "inputs_sha256"],
      "properties": {
        "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
        "package_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "inputs_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "measurement_set": {
      "description": "P3.4 bound measurement declaration. Synthetic test values are explicitly not real audio measurements.",
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "schema_version", "plan", "format", "units", "provenance", "manifest_sha256"],
      "properties": {
        "artifact": {"const": "scene_plan_measurements"}, "schema_version": {"const": "1.0"},
        "plan": {"$ref": "#/$defs/plan_binding"}, "format": {"enum": ["short", "long"]},
        "units": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["unit_id", "shot_id", "text_sha256", "duration_seconds", "audio_sha256", "sample_rate_hz"],
            "properties": {
              "unit_id": {"$ref": "#/$defs/beat_id"}, "shot_id": {"$ref": "#/$defs/shot_id"},
              "text_sha256": {"$ref": "#/$defs/sha256"}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
              "audio_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
              "sample_rate_hz": {"type": ["integer", "null"], "minimum": 1}
            }
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false, "required": ["kind", "producer", "recorded_at"],
          "properties": {"kind": {"enum": ["synthetic_test", "measured_audio"]},
                         "producer": {"type": "string", "minLength": 1}, "recorded_at": {"type": "string", "minLength": 1}}
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "strings": {"type": "array", "items": {"type": "string"}},
    "beat_id": {"type": "string", "pattern": "^BEAT_[A-Z0-9_]+$"},
    "shot_id": {"type": "string", "pattern": "^SH_[SL]_[0-9]{3}$"},
    "scene_id": {"type": "string", "pattern": "^SC_[SL]_[0-9]{2}$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]+_[A-Z0-9_]+$"}},
    "status": {"enum": ["supported_direct", "supported_parameterized", "editorial_review", "requires_new_capability"]},
    "asset_pin": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "sha256"],
      "properties": {"kind": {"type": "string"}, "id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1},
                     "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "format_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "format_id", "aspect_ratio", "viewport", "fps", "intent", "chapters", "scenes", "shots",
                   "timing", "capability_summary"],
      "properties": {
        "format": {"enum": ["short", "long"]},
        "format_id": {"enum": ["FMT_SHORT", "FMT_LONG"]},
        "aspect_ratio": {"enum": ["9:16", "16:9"]},
        "viewport": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": {"width": {"type": "integer"}, "height": {"type": "integer"}}
        },
        "fps": {"const": 30},
        "intent": {"type": "string"},
        "chapters": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["chapter_id", "title", "scene_ids"],
            "properties": {"chapter_id": {"type": "string", "pattern": "^CH_[A-Z0-9_]+$"}, "title": {"type": "string"},
                           "scene_ids": {"type": "array", "items": {"$ref": "#/$defs/scene_id"}}}
          }
        },
        "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
        "shots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shot"}},
        "timing": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "estimate_basis", "estimated_seconds", "estimated_narration_seconds",
                       "planned_silence_seconds", "action_and_framing_seconds", "target"],
          "properties": {
            "status": {"const": "provisional_estimate_pending_measured_narration"},
            "estimate_basis": {"type": "string"}, "estimated_seconds": {"type": "number", "minimum": 0},
            "estimated_narration_seconds": {"type": "number", "minimum": 0},
            "planned_silence_seconds": {"type": "number", "minimum": 0},
            "action_and_framing_seconds": {"type": "number"},
            "target": {"type": ["object", "null"]}
          }
        },
        "capability_summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_id", "order", "chapter_id", "location_id", "beat_ids", "shot_ids", "location_change",
                   "canonical_time_markers", "environment", "lighting", "atmosphere", "transition_in", "reviewed",
                   "estimated_seconds"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/scene_id"}, "order": {"type": "integer", "minimum": 1},
        "chapter_id": {"type": "string"}, "location_id": {"type": "string", "pattern": "^LOC_[A-Z0-9_]+$"},
        "beat_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/beat_id"}},
        "shot_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shot_id"}},
        "location_change": {"type": "boolean"}, "canonical_time_markers": {"$ref": "#/$defs/strings"},
        "environment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/asset_pin"}]},
        "lighting": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/asset_pin"}]},
        "atmosphere": {"type": ["string", "null"]},
        "transition_in": {"enum": ["cut", "time_ellipsis", "continuous"]},
        "reviewed": {"type": "boolean"}, "estimated_seconds": {"type": "number", "minimum": 0}
      }
    },
    "shot": {
      "type": "object", "additionalProperties": false,
      "required": ["shot_id", "order", "kind", "scene_id", "chapter_id", "source", "options", "staging", "motion_plan",
                   "descriptive_proposal", "capability", "editorial_acknowledged", "continuity", "timing", "blockers"],
      "properties": {
        "shot_id": {"$ref": "#/$defs/shot_id"}, "order": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["narrative", "reaction_hold"]}, "scene_id": {"$ref": "#/$defs/scene_id"},
        "chapter_id": {"type": "string"},
        "options": {
          "type": "object", "additionalProperties": false, "required": ["marks", "reach_facing", "props", "presence", "lighting_states"],
          "properties": {"marks": {"type": "object", "additionalProperties": {"type": "number"}}, "reach_facing": {"type": "object"},
                         "props": {"type": "object"}, "presence": {"$ref": "#/$defs/strings"}, "lighting_states": {"$ref": "#/$defs/strings"}}
        },
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["beat_id", "chapter_id", "event_ids", "character_ids", "location_id", "object_ids", "sound_cue_ids",
                       "narration", "dialogue", "facts", "ambiguity_ids", "continuity_rule_ids", "reviewed_staging",
                       "silence_after_seconds"],
          "properties": {
            "beat_id": {"$ref": "#/$defs/beat_id"}, "chapter_id": {"type": "string"}, "event_ids": {"$ref": "#/$defs/ids"},
            "character_ids": {"$ref": "#/$defs/ids"}, "location_id": {"type": "string"}, "object_ids": {"$ref": "#/$defs/ids"},
            "sound_cue_ids": {"$ref": "#/$defs/ids"},
            "narration": {
              "type": "object", "additionalProperties": false,
              "required": ["mode", "text", "sources", "working_spans", "attribution"],
              "properties": {
                "mode": {"enum": ["verbatim", "authored_proposal"]}, "text": {"type": "string", "minLength": 1},
                "sources": {"type": "array", "minItems": 1}, "working_spans": {"type": "array"},
                "attribution": {"enum": ["verbatim_reviewed_source", "explicitly_accepted_authored_proposal"]}
              }
            },
            "dialogue": {"type": "array"}, "facts": {"type": "array"}, "ambiguity_ids": {"$ref": "#/$defs/ids"},
            "continuity_rule_ids": {"$ref": "#/$defs/ids"},
            "reviewed_staging": {
              "type": "object", "required": ["action", "basis", "executable"],
              "properties": {"basis": {"const": "reviewed_story_staging_proposal"}, "executable": {"const": false}}
            },
            "silence_after_seconds": {"type": "number", "minimum": 0}
          }
        },
        "staging": {
          "type": "object", "additionalProperties": false,
          "required": ["basis", "shot_size", "camera_move", "camera", "lighting", "atmosphere", "presence", "cast",
                       "offscreen", "props", "dialogue_delivery", "sound", "reveal"],
          "properties": {
            "basis": {"const": "creative_proposal_not_canonical_fact"},
            "shot_size": {"enum": ["establishing_wide", "wide", "medium", "medium_close", "close_up"]},
            "camera_move": {"enum": ["static", "slow_push_in", "slow_pull_out", "slow_pan", "handheld_drift", "dolly_zoom"]},
            "camera": {
              "type": "object", "additionalProperties": false,
              "required": ["keys", "framed_subjects", "framed_out", "visible_world_width"],
              "properties": {
                "keys": {"type": "array", "minItems": 2,
                         "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}},
                "framed_subjects": {"$ref": "#/$defs/strings"}, "framed_out": {"$ref": "#/$defs/strings"},
                "visible_world_width": {"type": "number", "exclusiveMinimum": 0}
              }
            },
            "lighting": {"type": "object"}, "atmosphere": {"type": ["string", "null"]},
            "presence": {
              "oneOf": [{"type": "null"},
                        {"type": "object", "required": ["character_id", "anchor", "visibility", "identity_revealed"],
                         "properties": {"visibility": {"const": "partial_silhouette"}, "identity_revealed": {"const": false}}}]
            },
            "cast": {"type": "array", "items": {"$ref": "#/$defs/cast"}},
            "offscreen": {"type": "array"}, "props": {"type": "array"}, "dialogue_delivery": {"type": "object"},
            "sound": {"type": "object", "required": ["cues", "silence_seconds", "silence_role"]},
            "reveal": {
              "type": "object", "required": ["canonical_reveal_beat", "identity_reveal_allowed", "uncertainty"],
              "properties": {"identity_reveal_allowed": {"const": false}}
            }
          }
        },
        "motion_plan": {
          "type": "object", "additionalProperties": false, "required": ["kind", "basis", "actors"],
          "properties": {
            "kind": {"const": "executable_estimate"}, "basis": {"type": "string"},
            "actors": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["character_id", "steps"],
                "properties": {
                  "character_id": {"type": "string"},
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object", "additionalProperties": false, "required": ["preset", "acting_asset", "t0", "t1", "params"],
                      "properties": {
                        "preset": {"enum": ["hold", "listening_freeze", "startled_reaction", "guarded_reach", "cautious_walk"]},
                        "acting_asset": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/asset_pin"}]},
                        "t0": {"type": "number", "minimum": 0}, "t1": {"type": "number", "minimum": 0},
                        "params": {"type": "object"}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "descriptive_proposal": {
          "type": "object", "additionalProperties": false, "required": ["text", "executable", "note"],
          "properties": {"text": {"type": "string"}, "executable": {"const": false}, "note": {"type": "string"}}
        },
        "capability": {
          "type": "object", "additionalProperties": false, "required": ["status", "reason", "items"],
          "properties": {
            "status": {"$ref": "#/$defs/status"}, "reason": {"type": "string"},
            "items": {
              "type": "array",
              "items": {"type": "object", "required": ["requirement", "subject", "status", "basis"],
                        "properties": {"status": {"$ref": "#/$defs/status"}}}
            }
          }
        },
        "editorial_acknowledged": {"type": "boolean"},
        "continuity": {
          "type": "object", "additionalProperties": false, "required": ["transition_in", "before", "after", "notes"],
          "properties": {
            "transition_in": {"enum": ["cut", "time_ellipsis", "continuous", "within_scene"]},
            "before": {"type": "object"}, "after": {"type": "object"}, "notes": {"$ref": "#/$defs/strings"}
          }
        },
        "timing": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "narration_unit_id", "narration", "lead_seconds", "tail_seconds", "planned_silence_seconds",
                       "action", "estimated_seconds", "format_start_seconds", "frame_grid", "pending_measurement"],
          "properties": {
            "status": {"const": "provisional_estimate"},
            "narration_unit_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/beat_id"}]},
            "narration": {"type": "object", "required": ["syllables", "estimated_seconds", "interval_seconds",
                                                          "format_interval_seconds"]},
            "lead_seconds": {"type": "number"}, "tail_seconds": {"type": "number"},
            "planned_silence_seconds": {"type": "number", "minimum": 0},
            "action": {"type": "object", "required": ["minimum_seconds", "steps"]},
            "estimated_seconds": {"type": "number", "exclusiveMinimum": 0},
            "format_start_seconds": {"type": "number", "minimum": 0},
            "frame_grid": {"type": "object", "required": ["fps", "estimated_start_frame", "estimated_frame_count", "quantization"]},
            "pending_measurement": {"type": "object", "required": ["required", "dependency"]}
          }
        },
        "blockers": {"$ref": "#/$defs/strings"}
      }
    },
    "cast": {
      "type": "object", "additionalProperties": false,
      "required": ["character_id", "representation", "asset", "entry", "start_mark", "end_mark", "start_x", "end_x",
                   "facing", "performance", "emotion", "visible"],
      "properties": {
        "character_id": {"type": "string", "pattern": "^CHR_[A-Z0-9_]+$"}, "representation": {"const": "character"},
        "asset": {"$ref": "#/$defs/asset_pin"},
        "entry": {"enum": ["present_at_cut", "revealed_by_framing", "enter_walk"]},
        "start_mark": {"type": ["string", "null"]}, "end_mark": {"type": "string"},
        "start_x": {"type": "number"}, "end_x": {"type": "number"}, "facing": {"enum": [-1, 1]},
        "performance": {"type": "string"}, "emotion": {"type": "string"}, "visible": {"type": "boolean"}
      }
    }
  }
}
